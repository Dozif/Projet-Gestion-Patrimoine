# Copiez ce fichier en « .env » à côté de docker-compose.yml sur le Synology, puis remplacez chaque valeur.
# Clé secrète : générez-la sur le PC avec  py -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=a-remplacer
# Votre sous-domaine, plus 127.0.0.1 et localhost (contrôle de santé du conteneur)
DJANGO_ALLOWED_HOSTS=patrimoine.votredomaine.fr,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://patrimoine.votredomaine.fr
# N'utilisez dans les valeurs ni $, ni #, ni guillemets, ni espaces.
# Compte créé au premier démarrage s'il n'existe aucun compte. Choisissez un identifiant peu devinable :
# 5 erreurs de mot de passe bloquent cet identifiant pendant une heure.
PATRIMOINE_ADMIN_UTILISATEUR=choisir-un-identifiant-peu-devinable
# Mot de passe : 12 caractères minimum ; changez-le ensuite dans l'application puis effacez cette ligne.
PATRIMOINE_ADMIN_MOT_DE_PASSE=a-remplacer
# Code demandé avant d'afficher le QR code (première connexion) : 16 caractères minimum, générez-le avec
#   py -c "import secrets; print(secrets.token_urlsafe(16))"
PATRIMOINE_CODE_INSTALLATION=a-remplacer
